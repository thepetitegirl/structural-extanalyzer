# Copy to .env and fill in. .env is gitignored and must never be committed.

# Google AI Studio - free tier, no card required.
# Create at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq - free tier, hosts open-source models (gpt-oss, Llama).
# Create at: https://console.groq.com/keys
GROQ_API_KEY=

# Ollama - local models, no key needed.
# Only set this if Ollama runs somewhere other than the default localhost:11434.
OLLAMA_HOST=
